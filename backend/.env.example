# Cable-N backend settings - copy to backend/.env (never commit .env).
APP_NAME=Cable-N
# development | production (production hides error details and sends HSTS)
APP_ENV=development
# Comma-separated browser origins allowed to call the API directly.
# Not needed when the backend serves the built site itself (same origin).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true ONLY when running behind your own reverse proxy (Caddy/nginx) so the
# client IP for rate limiting is read from X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# ---- public-API protection ---------------------------------------------
MAX_BODY_KB=512
MAX_UPLOAD_MB=8
CALC_RATE_PER_MINUTE=60
REPORT_RATE_PER_MINUTE=6
VALIDATION_RATE_PER_MINUTE=4
ENGINE_TIMEOUT_S=20
ENGINE_MAX_CONCURRENT=4
BATCH_MAX_FEEDERS=200
SWEEP_MAX_POINTS=15

# ---- optional AI assistant (Google Gemini) - see docs/API_SETUP.md --------
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_RATE_PER_MINUTE=3
AI_DAILY_PER_IP=20
AI_DAILY_GLOBAL=500

# ---- optional ad-free licence keys (future premium tier) ---------------
# Empty = feature off. Generate with: python -m app.cli new-secret
PREMIUM_SECRET=
