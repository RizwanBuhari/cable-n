# Cable-N website - frontend build settings (copy to .env.local and edit).
# Every value here is PUBLIC: it is compiled into the JavaScript the browser
# downloads. Never put secrets in this file.

# API location. Default "/api/v1" works with the dev proxy and when the backend
# serves the built site. Only change it if the API lives on another origin.
VITE_API_BASE_URL=/api/v1

# Public URL of the website, used for canonical links, sitemap.xml and Open Graph.
VITE_SITE_URL=http://localhost:5173

# Optional contact address shown on the Contact page (leave empty to hide).
VITE_CONTACT_EMAIL=

# ---- Google AdSense (optional; see docs/ADSENSE_SETUP.md) -------------------
VITE_ADS_ENABLED=false
# Publisher ID, e.g. ca-pub-1234567890123456
VITE_ADSENSE_CLIENT=
# Ad unit slot IDs (numbers) for the right-hand rail and the in-page panel
VITE_ADSENSE_SLOT_RAIL=
VITE_ADSENSE_SLOT_INLINE=
# Consent: "own"  = Cable-N's banner gates ad loading (non-EEA/UK traffic),
#          "google" = Google's certified CMP from AdSense "Privacy & messaging"
#                     (required for EEA/UK/Switzerland visitors).
VITE_ADSENSE_CMP=own
